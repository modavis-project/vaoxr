{
  "name": "vaoxr",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "VAO-based organ exploration, sampled playback, and mobile and Quest augmented reality.",
  "homepage": "https://vaoxr.modavis.org",
  "repository": { "type": "git", "url": "https://github.com/modavis-project/vaoxr.git" },
  "bugs": { "url": "https://github.com/modavis-project/vaoxr/issues" },
  "author": "Dominik Ukolov",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:assets": "vitest run tests/assets",
    "test:media": "python3 -m unittest discover -s tests/media",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "audit:prod": "npm audit --omit=dev",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run deadcode && npm audit && npm test && npm run test:media && npm run test:e2e",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "source:check": "bash scripts/check-unity-source.sh",
    "assets:build": "bash scripts/build-assets.sh",
    "performance:build": "node scripts/pipeline/extract_performance.mjs",
    "ar:model": "node scripts/pipeline/build_ar_model.mjs",
    "ar:usdz": "bash scripts/pipeline/export-ar-usdz.sh",
    "ar:compile-target": "node scripts/pipeline/compile_ar_target.mjs",
    "social:build": "node scripts/pipeline/create_social_card.mjs",
    "media:seed": "bash scripts/seed-local-media.sh",
    "media:fetch": "python3 scripts/fetch-media.py",
    "vao:setup": "bash scripts/vao/setup-validator.sh",
    "vao:validate": "bash scripts/vao/validate-release.sh"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "lucide-react": "^0.544.0",
    "mind-ar": "1.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.183.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@eslint/js": "9.39.4",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@napi-rs/canvas": "0.1.80",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@types/webxr": "0.5.24",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.2",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "knip": "5.63.1",
    "meshoptimizer": "0.24.0",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "vitest": "3.2.7",
    "wrangler": "4.128.0"
  },
  "type": "module",
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "mind-ar": {
      "canvas": "npm:@napi-rs/canvas@0.1.80"
    }
  }
}
