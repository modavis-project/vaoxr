# Optional asset regeneration from the separately supplied Unity project.
# Export these variables in your shell; the pipeline does not load this file.
POSITIVXR_UNITY_SOURCE=/path/to/VAOrgan
POSITIVXR_MEDIA_OUTPUT=work/asset-pipeline/media
BLENDER_BIN=blender

# Optional Vite file-watching fallback.
VITE_USE_POLLING=false
